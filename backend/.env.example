# Server
PORT=3001
NODE_ENV=development

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Demo mode — set to true to use hardcoded test OTPs
DEMO_MODE=true

# JWT — change this to a long random secret in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Staff credentials (dealer + admin)
DEALER_USERNAME=suresh.patil
DEALER_PASSWORD=replace-with-dealer-password
ADMIN_USERNAME=sharma.district
ADMIN_PASSWORD=replace-with-admin-password
